# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=sqlite:///./churn.db

# Secret key used to sign JWT access tokens - generate your own, e.g.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-value

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Path to the trained ML artifacts (relative to backend/ or absolute)
MODEL_PATH=../ml/model/churn_model.pkl
METRICS_PATH=../ml/model/metrics.json

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Default admin account created on first startup if no users exist
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123!
